# BuildSmart web — build-time environment variables.
# Copy to `.env` for local development. Never put secrets here: every VITE_*
# value is inlined into the public JavaScript bundle.

# Backend API base URL.
# - Leave unset, empty, or set to a localhost URL to call the API through the same
#   origin. The Vite dev server proxies /api to http://localhost:8000 and
#   vercel.json rewrites /api to the Render service, which keeps the auth cookie
#   first-party.
# - Set an absolute https URL to call the Render service directly (requires CORS,
#   which the API allows for the deployed frontend origin).
# VITE_API_URL=https://build-smart-ai-42f1.onrender.com

# Mock mode is disabled permanently; the app always talks to the live API.
VITE_USE_MOCK=false

# PostHog Analytics
# In development / test modes, tracking is automatically opted out and silenced.
VITE_POSTHOG_KEY=phc_placeholder_buildsmart_ai_2026
VITE_POSTHOG_HOST=https://us.i.posthog.com
