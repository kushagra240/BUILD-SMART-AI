  "components": {
    "schemas": {
      "BreakdownCategoryItem": {
        "properties": {
          "category": {
            "type": "string",
            "title": "Category"
          },
          "amount": {
            "type": "integer",
            "title": "Amount"
          },
          "share_pct": {
            "type": "number",
            "title": "Share Pct"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "category",
          "amount",
          "share_pct"
        ],
        "title": "BreakdownCategoryItem"
      },
      "BudgetAssessment": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "within",
              "tight",
              "below_minimum",
              "not_provided"
            ],
            "title": "Status"
          },
          "gap_inr": {
            "type": "integer",
            "title": "Gap Inr",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "BudgetAssessment"
      },
      "ConfidenceEstimate": {
        "properties": {
          "label": {
            "type": "string",
            "enum": [
              "High",
              "Medium",
              "Low"
            ],
            "title": "Label"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "label",
          "reason"
        ],
        "title": "ConfidenceEstimate"
      },
      "ConstructionTypeOption": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "ConstructionTypeOption"
      },
      "CostDriverItem": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "impact_pct": {
            "type": "number",
            "title": "Impact Pct"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "label",
          "impact_pct"
        ],
        "title": "CostDriverItem"
      },
      "EstimateCreate": {
        "properties": {
          "built_up_area_sqft": {
            "type": "number",
            "maximum": 100000.0,
            "exclusiveMinimum": 0.0,
            "title": "Built Up Area Sqft",
            "description": "Total built-up area in sqft"
          },
          "floors": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Floors",
            "description": "Number of floors"
          },
          "bedrooms": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Bedrooms",
            "description": "Number of bedrooms"
          },
          "bathrooms": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Bathrooms",
            "description": "Number of bathrooms"
          },
          "zone_id": {
            "type": "string",
            "maxLength": 50,
            "minLength": 2,
            "title": "Zone Id",
            "description": "Location zone identifier"
          },
          "quality_tier": {
            "type": "string",
            "enum": [
              "economy",
              "standard",
              "premium"
            ],
            "title": "Quality Tier",
            "description": "Quality tier"
          },
          "construction_type": {
            "type": "string",
            "enum": [
              "rcc_framed",
              "load_bearing"
            ],
            "title": "Construction Type",
            "description": "Construction type"
          },
          "plot_area_sqft": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 200000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Plot Area Sqft",
            "description": "Optional plot area"
          },
          "budget_inr": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget Inr",
            "description": "Optional target budget in INR"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "built_up_area_sqft",
          "floors",
          "bedrooms",
          "bathrooms",
          "zone_id",
          "quality_tier",
          "construction_type"
        ],
        "title": "EstimateCreate"
      },
      "EstimateResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "project_id": {
            "type": "string",
            "format": "uuid",
            "title": "Project Id"
          },
          "total": {
            "$ref": "#/components/schemas/TotalEstimate"
          },
          "confidence": {
            "$ref": "#/components/schemas/ConfidenceEstimate"
          },
          "breakdown": {
            "items": {
              "$ref": "#/components/schemas/BreakdownCategoryItem"
            },
            "type": "array",
            "title": "Breakdown"
          },
          "materials": {
            "items": {
              "$ref": "#/components/schemas/MaterialRecommendationItem"
            },
            "type": "array",
            "title": "Materials"
          },
          "budget": {
            "$ref": "#/components/schemas/BudgetAssessment"
          },
          "drivers": {
            "items": {
              "$ref": "#/components/schemas/CostDriverItem"
            },
            "type": "array",
            "title": "Drivers"
          },
          "model": {
            "$ref": "#/components/schemas/ModelMetaItem"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer"
          },
          "inputs": {
            "$ref": "#/components/schemas/EstimateCreate"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "project_id",
          "total",
          "confidence",
          "breakdown",
          "materials",
          "budget",
          "drivers",
          "model",
          "disclaimer",
          "inputs",
          "created_at"
        ],
        "title": "EstimateResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "MaterialRecommendationItem": {
        "properties": {
          "category": {
            "type": "string",
            "title": "Category"
          },
          "primary": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                }
              ]
