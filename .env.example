# Environment Variables Template for BuildSmart AI
# DO NOT put real secrets in this file.

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Database (PostgreSQL)
POSTGRES_USER=buildsmart
POSTGRES_PASSWORD=buildsmart_dev_secret
POSTGRES_DB=buildsmart_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://buildsmart:buildsmart_dev_secret@localhost:5432/buildsmart_db

# Security & Authentication (JWT & Argon2id)
# Generate secret using `openssl rand -hex 32`
JWT_SECRET=dev_jwt_secret_change_in_production_min_32_bytes_long
JWT_ISSUER=buildsmart-api
JWT_AUDIENCE=buildsmart-web
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Reverse Proxy & Security
# Comma-separated list of trusted proxy IP addresses (e.g. Nginx, Cloudflare, AWS ALB)
# Only proxies in this list are allowed to populate client IP via X-Forwarded-For
TRUSTED_PROXIES=127.0.0.1,::1

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Cookies
COOKIE_SECURE=false

# ML Model Loading
MODEL_PATH=ml/artifacts/model-v1.0.0.joblib

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
