# Environment Variables Template for BuildSmart AI
# DO NOT put real secrets in this file.

# Environment
# PRODUCTION (Render): set ENVIRONMENT=production, DEBUG=false, a unique
# 32+ character JWT_SECRET and a managed PostgreSQL DATABASE_URL. The API refuses
# to start if production still uses the development defaults below.
# CORS does NOT need to be set: the deployed frontend origin is always allowed.
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Database (PostgreSQL)
POSTGRES_USER=buildsmart
POSTGRES_PASSWORD=buildsmart_dev_secret
POSTGRES_DB=buildsmart_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://buildsmart:buildsmart_dev_secret@localhost:5432/buildsmart_db

# Security & Authentication (JWT & Argon2id)
# Generate secret using `openssl rand -hex 32`
JWT_SECRET=dev_jwt_secret_change_in_production_min_32_bytes_long
JWT_ISSUER=buildsmart-api
JWT_AUDIENCE=buildsmart-web
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Reverse Proxy & Security
# Comma-separated list of trusted proxy IP addresses (e.g. Nginx, Cloudflare, AWS ALB).
# Only proxies in this list (or internal/private addresses such as a cloud edge
# proxy) are allowed to populate the client IP via X-Forwarded-For.
TRUSTED_PROXIES=127.0.0.1,::1

# CORS
# Comma-separated browser origins. `CORS_ORIGINS` is accepted as an alias, because
# that is what hosting dashboards usually call it.
# In production the deployed frontend (https://build-smart-ai-vert.vercel.app) is
# always allowed and http://localhost entries are ignored, so a missing or stale
# value cannot break browser authentication. Never use '*': credentialed CORS
# would then expose responses to any site.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Preview deployments of this Vercel project. Set to empty to disable previews.
ALLOWED_ORIGIN_REGEX=^https://build-smart-ai[a-z0-9-]*\.vercel\.app$

# Cookies
COOKIE_SECURE=false

# ML Model Loading
MODEL_PATH=ml/artifacts/model-v1.0.0.joblib

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
